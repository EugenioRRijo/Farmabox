{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2020"
  },
  "include": ["*.js", "./scripts/**/*.ts", "./scripts/**/*.js"],
  "exclude": ["node_modules"]
}
