{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020"
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    ".eslintrc.json"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
