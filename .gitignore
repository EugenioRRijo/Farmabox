USM-Scheduler-Portable/

# Artefactos de build / staging (se regeneran)
src/electron/frontend/
*.tsbuildinfo

# Datos de runtime del backend Express (se siembran desde @scheduler/shared)
src/backend/data/

# vite.config compilado: NO debe existir, eclipsa a vite.config.ts
# (sin base:'./' → rutas absolutas → pantalla en blanco en el .exe)
src/frontend/vite.config.js
src/frontend/vite.config.d.ts

# Secretos: NUNCA se commitean (ni el plano ni el cifrado).
# El .exe distribuido ya los lleva embebidos. Para reconstruir:
#   1) crear secrets.plain.json (desde secrets.plain.example.json) con las keys reales
#   2) node scripts/encrypt-secrets.cjs   → genera secrets.enc
**/secrets.plain.json
**/secrets.enc
