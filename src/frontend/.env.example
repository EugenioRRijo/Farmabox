# Modo WEB (navegador / npm run dev): el frontend habla directo a Supabase.
# Copiá este archivo a `.env` y poné los valores reales (los mismos de
# src/electron/secrets.plain.json). En la app de escritorio (.exe) NO se usan:
# ahí los datos van por IPC al proceso de Electron.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-o-publishable-key
