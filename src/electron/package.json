{
  "name": "@scheduler/electron",
  "version": "1.0.12",
  "description": "Sistema de Gestión de Horarios Académicos",
  "author": "Eugenio Rijo",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron .",
    "build": "tsc",
    "package": "electron-builder"
  },
  "dependencies": {
    "@scheduler/shared": "*",
    "@supabase/supabase-js": "^2.107.0",
    "electron-log": "^5.0.0",
    "electron-updater": "^6.8.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "28.2.0",
    "electron-builder": "^26.7.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "electronVersion": "28.2.0",
    "appId": "ve.edu.usm.farmabox",
    "productName": "Farmabox",
    "publish": [
      {
        "provider": "github",
        "owner": "EugenioRRijo",
        "repo": "Farmabox-releases"
      }
    ],
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "splash.html",
      "assets/**/*",
      "secrets.enc",
      {
        "from": "frontend",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "copyright": "Copyright © 2026 Eugenio Rijo — Servicio Comunitario, USM Facultad de Farmacia",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Farmabox",
      "uninstallDisplayName": "Farmabox - USM Farmacia",
      "artifactName": "Farmabox-Setup-${version}.${ext}"
    }
  }
}
